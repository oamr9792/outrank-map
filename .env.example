# DataForSEO: login is your account email; the password is the API password
# from app.dataforseo.com/api-access, NOT your account login password.
# Used to pull the live Google results for each person-name keyword.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Hard ceiling on DataForSEO spend per run, in USD.
DATAFORSEO_MAX_USD=10

# Ahrefs API v3 key: Ahrefs → Account settings → API keys.
# Used once per study to list the target's person-name keywords (~15 units each).
AHREFS_API_KEY=

PORT=8801
HOST=127.0.0.1
DB_PATH=data/outrank-map.db
# Parallel live SERP calls. Each takes ~25 s, so this sets the run's pace.
SERP_CONCURRENCY=8
EXTRA_CA_CERTS=
